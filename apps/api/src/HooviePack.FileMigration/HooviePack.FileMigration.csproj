<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HooviePack.Api\HooviePack.Api.csproj" />
    <ProjectReference Include="..\HooviePack.Files.Api\HooviePack.Files.Api.csproj" />
  </ItemGroup>

  <!-- The importer is configured by environment/CLI. Referenced web projects otherwise
       contribute colliding appsettings files that are unrelated to this one-shot tool. -->
  <Target Name="RemoveReferencedAppSettingsFromPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings.')) Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json'" />
    </ItemGroup>
  </Target>

</Project>

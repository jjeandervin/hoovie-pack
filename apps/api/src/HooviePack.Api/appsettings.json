{
  "Authentication": {
    "Authority": "http://localhost:8081/realms/hooviepack",
    "Audience": "hooviepack-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://hooviepack.jeandervin.com"
    ]
  },
  "Database": {
    "ApplyMigrations": false
  },
  "MediaStorage": {
    "MaxImageBytes": 10485760
  },
  "FileService": {
    "BaseUrl": "http://files-api:8080",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

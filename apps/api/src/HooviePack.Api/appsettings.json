{
  "DogApi": {
    "BaseUrl": "https://dogapi.dog/api/v2/",
    "PageSize": 1000,
    "TimeoutSeconds": 30
  },
  "Dogipedia": {
    "Sync": {
      "Enabled": true,
      "FreshnessHours": 24,
      "CheckIntervalMinutes": 60
    }
  },
  "Authentication": {
    "Authority": "http://localhost:8081/realms/hooviepack",
    "Audience": "hooviepack-api",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://hooviepack.jeandervin.com"
    ]
  },
  "Database": {
    "ApplyMigrations": false
  },
  "MediaStorage": {
    "MaxImageBytes": 10485760
  },
  "FileService": {
    "BaseUrl": "http://files-api:8080",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}

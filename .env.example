# Copy this file to .env before running Docker Compose. Every value marked
# "replace" is intentionally non-secret sample text and must be changed.

COMPOSE_PROJECT_NAME=hooviepack

# Local host bindings. Keep BIND_ADDRESS on loopback unless a reverse proxy,
# firewall, and TLS have been configured deliberately.
BIND_ADDRESS=127.0.0.1
WEB_PORT=4200
API_PORT=5000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8081

# Application-facing URLs. These are read by a browser, not by a container.
APP_ORIGIN=http://localhost:4200
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# API-only OIDC discovery/JWKS backchannel. The default stays on the private
# Compose network; RequireHttpsMetadata must remain false while this is HTTP.
KEYCLOAK_METADATA_URL=http://keycloak:8080/realms/hooviepack/.well-known/openid-configuration
API_BASE_URL=/api
OIDC_CLIENT_ID=hooviepack-web
API_AUDIENCE=hooviepack-api

# ASP.NET Core and migrations. Set Production as documented for deployment.
# Set AUTH_REQUIRE_HTTPS_METADATA=true only with an HTTPS metadata URL.
APP_ENVIRONMENT=Development
AUTH_REQUIRE_HTTPS_METADATA=false
DATABASE_APPLY_MIGRATIONS=true

# HooviePack application database.
POSTGRES_DB=hooviepack
POSTGRES_USER=hooviepack
POSTGRES_PASSWORD=replace-with-a-long-random-app-db-password

# Keycloak database and bootstrap administrator. The bootstrap account is
# created only when the Keycloak database is empty.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-keycloak-db-password
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-admin-password

# Development-only users imported into the hooviepack realm. Their passwords
# are temporary, but the accounts should still be disabled/deleted in prod.
DEMO_OWNER_PASSWORD=replace-with-a-demo-owner-password
DEMO_MEMBER_PASSWORD=replace-with-a-demo-member-password

# Production reverse proxy paths. The whole Let's Encrypt directory is mounted
# so that its live/ symlinks can resolve into archive/.
LETSENCRYPT_DIR=./infra/nginx/letsencrypt
ACME_CHALLENGE_DIR=./infra/nginx/acme
HTTP_PORT=80
HTTPS_PORT=443

# Image pins are centralized to make deliberate upgrades easy.
POSTGRES_IMAGE=postgres:17-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1
NGINX_IMAGE=nginx:1.28-alpine

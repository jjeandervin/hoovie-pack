# Copy this file to .env before running Docker Compose. Every value marked
# "replace" is intentionally non-secret sample text and must be changed.

COMPOSE_PROJECT_NAME=hooviepack

# Local host bindings. Keep BIND_ADDRESS on loopback unless a reverse proxy,
# firewall, and TLS have been configured deliberately.
BIND_ADDRESS=127.0.0.1
WEB_PORT=4200
API_PORT=5000
FILES_API_PORT=5001
POSTGRES_PORT=5432
KEYCLOAK_PORT=8081

# Application-facing URLs. These are read by a browser, not by a container.
APP_ORIGIN=http://localhost:4200
KEYCLOAK_PUBLIC_URL=http://localhost:8081
# API-only OIDC discovery/JWKS backchannel. Development permits this trusted
# Docker HTTP host; the production overlay keeps the general HTTPS policy on,
# and the API narrowly exempts only this internal host (or loopback).
KEYCLOAK_METADATA_URL=http://keycloak:8080/realms/hooviepack/.well-known/openid-configuration
API_BASE_URL=/api
OIDC_CLIENT_ID=hooviepack-web
API_AUDIENCE=hooviepack-api
# Exact browser-visible S3 bucket origin used by Content Security Policy. Do
# not include a path or trailing slash.
CSP_S3_ORIGIN=https://replace-with-private-bucket-name.s3.us-east-1.amazonaws.com

# ASP.NET Core and migrations. The production Compose overlay independently
# enforces HTTPS metadata policy and disables API-startup migrations.
APP_ENVIRONMENT=Development
AUTH_REQUIRE_HTTPS_METADATA=false
# Leave blank to apply migrations on local API startup. Production ignores this
# switch and uses the explicit db-migrations one-shot service instead.
DATABASE_APPLY_MIGRATIONS=
# Leave blank to apply file-metadata migrations on local File Service startup.
# Production ignores this switch and uses files-db-migrations explicitly.
FILES_DATABASE_APPLY_MIGRATIONS=

# Internal API-to-File-Service authentication. This value is a deployment
# secret and must be independent of every database and AWS credential.
FILES_INTERNAL_API_KEY=replace-with-a-long-random-internal-file-service-key
FILES_API_TIMEOUT_SECONDS=10

# Private Amazon S3 file storage. The FILES_AWS_* values belong to a dedicated
# least-privilege identity and are mapped to the AWS SDK's standard variable
# names only inside files-api and the explicit legacy importer. Leave the
# session token blank for long-lived keys; prefer a workload role where available.
AWS_REGION=us-east-2
S3_BUCKET_NAME=replace-with-private-bucket-name
S3_KEY_PREFIX=files
S3_UPLOAD_URL_TTL_MINUTES=5
S3_DOWNLOAD_URL_TTL_MINUTES=5
S3_MAX_FILE_BYTES=10485760
FILES_AWS_ACCESS_KEY_ID=
FILES_AWS_SECRET_ACCESS_KEY=
FILES_AWS_SESSION_TOKEN=
# Optional SDK-compatible endpoint overrides for isolated development/testing.
# Production Amazon S3 deployments should leave these defaults unchanged.
S3_SERVICE_URL=
S3_FORCE_PATH_STYLE=false

# HooviePack application database.
POSTGRES_DB=hooviepack
POSTGRES_USER=hooviepack
POSTGRES_PASSWORD=replace-with-a-long-random-app-db-password

# Keycloak database and bootstrap administrator. The bootstrap account is
# created only when the Keycloak database is empty.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-keycloak-db-password
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-admin-password

# Development users imported into the hooviepack realm. Their passwords are
# temporary, but the accounts must still be disabled or deleted in production.
DEMO_OWNER_PASSWORD=replace-with-a-demo-owner-password
DEMO_MEMBER_PASSWORD=replace-with-a-demo-member-password

# Production reverse proxy paths. The whole Let's Encrypt directory is mounted
# so that its live/ symlinks can resolve into archive/.
LETSENCRYPT_DIR=./infra/nginx/letsencrypt
ACME_CHALLENGE_DIR=./infra/nginx/acme
HTTP_PORT=80
HTTPS_PORT=443

# Image pins are centralized to make deliberate upgrades easy.
POSTGRES_IMAGE=postgres:17-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.2
NGINX_IMAGE=nginx:1.28-alpine
